<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext only allowed for Minecraft server protocol traffic -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">play.pocketcraft.online</domain>
        <domain includeSubdomains="true">mine.pocketcraft.online</domain>
        <domain includeSubdomains="true">eu.pocketcraft.online</domain>
        <domain includeSubdomains="true">us.pocketcraft.online</domain>
        <domain includeSubdomains="true">13.233.131.236</domain>
        <domain includeSubdomains="true">3.72.235.245</domain>
        <domain includeSubdomains="true">98.83.40.35</domain>
        <domain includeSubdomains="true">13.201.57.41</domain>
        <domain includeSubdomains="true">54.93.247.2</domain>
        <domain includeSubdomains="true">18.225.223.45</domain>
        <!-- Add any specific Minecraft server domains that require cleartext -->
    </domain-config>
    <!-- All other traffic must use HTTPS -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>

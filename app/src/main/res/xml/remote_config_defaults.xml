<?xml version="1.0" encoding="utf-8"?>
<defaultsMap>
    <!-- New keys from remote control spec -->
    <entry>
        <key>feature_bedrock_crossplay_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>feature_subdomain_routing_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>relay_region_disabled_list</key>
        <value></value>
    </entry>
    <entry>
        <key>min_supported_version_code</key>
        <value>0</value>
    </entry>
    <entry>
        <key>recommended_version_code</key>
        <value>0</value>
    </entry>
    <entry>
        <key>review_prompt_min_successful_starts</key>
        <value>3</value>
    </entry>
    <entry>
        <key>review_prompt_enabled</key>
        <value>true</value>
    </entry>

    <!-- Existing keys in RemoteConfigManager -->
    <entry>
        <key>show_discord_button</key>
        <value>true</value>
    </entry>
    <entry>
        <key>show_instagram_button</key>
        <value>false</value>
    </entry>
    <entry>
        <key>feature_custom_subdomain_enabled</key>
        <value>false</value>
    </entry>
    <entry>
        <key>feature_premium_purchase_enabled</key>
        <value>false</value>
    </entry>
    <entry>
        <key>feature_free_trial_enabled</key>
        <value>false</value>
    </entry>

    <!-- playit.gg "International" route. Off until playit.gg gives written consent. -->
    <entry>
        <key>feature_playit_route_enabled</key>
        <value>false</value>
    </entry>

    <!-- Ads. ads_enabled (Play Store build) and ads_enabled_external (side-loaded
         build) are the master switches and ship off; each ads_spot_* key
         turns one placement on or off once the master switch is on. -->
    <entry>
        <key>ads_enabled</key>
        <value>false</value>
    </entry>
    <entry>
        <key>ads_enabled_external</key>
        <value>false</value>
    </entry>
    <entry>
        <key>ads_child_directed</key>
        <value>false</value>
    </entry>
    <entry>
        <key>ads_min_ram_mb</key>
        <value>3000</value>
    </entry>
    <entry>
        <key>ads_test_device_ids</key>
        <value></value>
    </entry>
    <entry>
        <key>ads_spot_boot</key>
        <value>true</value>
    </entry>
    <entry>
        <key>ads_spot_download</key>
        <value>true</value>
    </entry>
    <entry>
        <key>ads_spot_backup</key>
        <value>true</value>
    </entry>
    <entry>
        <key>ads_spot_import</key>
        <value>true</value>
    </entry>
    <entry>
        <key>ads_spot_plugin_list</key>
        <value>true</value>
    </entry>
    <entry>
        <key>ads_spot_rewarded_support</key>
        <value>true</value>
    </entry>
    <entry>
        <key>ads_spot_rewarded_pregen</key>
        <value>true</value>
    </entry>
    <entry>
        <key>ads_spot_stop_interstitial</key>
        <value>true</value>
    </entry>
</defaultsMap>

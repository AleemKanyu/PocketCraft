<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketCraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F5F7F3</item>
        <item name="android:statusBarColor">#F5F7F3</item>
        <item name="android:navigationBarColor">#F5F7F3</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.PocketCraft.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F5F7F3</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_square</item>
        <item name="postSplashScreenTheme">@style/Theme.PocketCraft</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">#F5F7F3</item>
        <item name="android:navigationBarColor">#F5F7F3</item>
    </style>
</resources>

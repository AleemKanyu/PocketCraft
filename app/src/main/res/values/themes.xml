<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketCraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#0A0A0F</item>
        <item name="android:statusBarColor">#0A0A0F</item>
        <item name="android:navigationBarColor">#0A0A0F</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.PocketCraft.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A0F</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_square</item>
        <item name="postSplashScreenTheme">@style/Theme.PocketCraft</item>
    </style>
</resources>

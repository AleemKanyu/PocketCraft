rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /user_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Deny high-frequency periodic heartbeat updates from older app builds
      allow write: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastHeartbeat', 'offlineHeartbeat', 'periodicStatus', 'heartbeatAt']));
    }

    // Web dashboard feature was removed in v1.6.0.
    // Disallowing reads/writes here immediately cuts off background listener loops in older app builds with PERMISSION_DENIED.
    match /users/{userId}/dashboard_commands/{commandId} {
      allow read, write: if false;
    }
    match /users/{userId}/dashboard_status/{statusId} {
      allow read, write: if false;
    }

    match /subdomains/{subdomain} {
      allow read: if true;
      allow create: if (
          // Signed-in user whose ownerId matches auth UID
          (signedIn() && request.resource.data.ownerId == request.auth.uid)
          // Device fallback (when user is unauthenticated or Compose cached null)
          || (request.resource.data.ownerId is string && request.resource.data.ownerId.size() > 0)
        )
        && request.resource.data.serverId is string
        && request.resource.data.createdAt != null
        && (
          !("region" in request.resource.data)
          || request.resource.data.region == null
          || (request.resource.data.region is string && request.resource.data.region.size() <= 16)
        );
      allow update: if (
          // Signed-in user owns it via ownerId or deviceId
          (signedIn() && resource.data.ownerId == request.auth.uid)
          || (signedIn() && ("deviceId" in resource.data) && resource.data.deviceId == request.auth.uid)
          // Incoming payload has matching ownerId or deviceId
          || (resource.data.ownerId == request.resource.data.ownerId)
          || (("deviceId" in request.resource.data) && resource.data.ownerId == request.resource.data.deviceId)
          || (("deviceId" in resource.data) && ("deviceId" in request.resource.data) && resource.data.deviceId == request.resource.data.deviceId)
          || (("deviceId" in resource.data) && resource.data.deviceId == request.resource.data.ownerId)
          // Legacy/orphaned document with no owner
          || (!("ownerId" in resource.data) || resource.data.ownerId == null || resource.data.ownerId == "")
          // The owner signed out and the one-day hold has run out, so anyone may take it
          || (("releaseAt" in resource.data) && resource.data.releaseAt is timestamp && resource.data.releaseAt <= request.time)
        );
      allow delete: if (
          (signedIn() && (
            resource.data.ownerId == request.auth.uid
            || (("deviceId" in resource.data) && resource.data.deviceId == request.auth.uid)
          ))
          || (!signedIn())
          || (resource.data.ownerId is string && !(resource.data.ownerId.matches('^[A-Za-z0-9_-]{28}$')))
          || (!("ownerId" in resource.data) || resource.data.ownerId == null)
        );
    }

    match /featureRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /beta_feedback/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /social_prompts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if false;
    }

    match /broadcast_responses/{responseId} {
      allow read, write: if signedIn();
    }

    match /broadcast_results/{resultId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /remote_commands/{commandId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /supporter_keys/{keyId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /compute_nodes/{nodeId} {
      allow read: if true;
      allow write: if true;
    }

    match /server_rentals/{rentalId} {
      allow read: if true;
      allow write: if true;
    }

    match /provider_financials/{nodeId} {
      allow read: if true;
      allow write: if true;
    }

    match /provider_payouts/{payoutId} {
      allow read: if true;
      allow write: if true;
    }

    // Read by every install before sign-in: the update notice and promotions.
    match /app_config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if false;
    }

    // No catch-all. Rules are additive, so a blanket "allow read" here made every
    // collection public, including users, tickets and supporter_keys, whatever the
    // rules above said. Anything not matched above is denied.
  }
}

# ----------------------------------------------------------------------
# PocketHost Production .htaccess (Optimized for SEO, Caching & Performance)
# ----------------------------------------------------------------------

# 1. Enable Compression (Gzip / Deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 2. Proper MIME Types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
  AddType text/plain .txt
  AddType application/vnd.android.package-archive .apk
  AddType font/ttf .ttf
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# 3. Browser Caching (Expires Headers)
<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration: 1 month
  ExpiresDefault "access plus 1 month"

  # HTML: Never cache so updates take effect immediately
  ExpiresByType text/html "access plus 0 seconds"

  # Data, Sitemaps & Manifests
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"

  # Static CSS & JS (Vite assets have cache-busting hashes)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images and Icons
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 4. Cache-Control & Security Headers
<IfModule mod_headers.c>
  # 1-year immutable caching for hashed assets and fonts
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff2|woff|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML, robots.txt, sitemap.xml and llms.txt are revalidated on every visit so they
  # are never stale. "no-store" is avoided: it disables the back/forward cache.
  <FilesMatch "(\.(html|htm)|robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Downloads and data files are not search results
  <FilesMatch "\.(zip|apk|md|json)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Canonical Redirects, Prerendered Pages & 404s
# Unknown URLs get a real 404 status (with a helpful page) instead of the home page.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. One URL per page: drop trailing slashes (/faq/ -> /faq) in a single hop
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://pockethost.online/$1 [L,R=301]

  # 2. Canonical Redirect: www to non-www (single-hop directly to HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.pockethost\.online$ [NC]
  RewriteRule ^(.*)$ https://pockethost.online/$1 [L,R=301]

  # 3. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://pockethost.online%{REQUEST_URI} [L,R=301]

  # 4. Old and duplicate addresses point at the clean URL
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://pockethost.online/ [L,R=301]
  RewriteRule ^(privacy|terms)\.html$ https://pockethost.online/$1 [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+_pages/(.+?)\.html[\s?] [NC]
  RewriteRule ^ https://pockethost.online/%1 [L,R=301]

  # Spotify OAuth Callback
  RewriteRule ^callback/?$ callback/index.html [L,QSA]

  # The World Drop page was removed; old links to it land on the home page.
  RewriteRule ^world/?$ https://pockethost.online/ [L,R=301]

  # 5. Prerendered pages. Each route is static HTML written by scripts/prerender.mjs,
  #    which replaces the line below with one rule per page at build time.
  # @@PRERENDERED_ROUTES@@
</IfModule>

+    private DefinitionRegistry<BlockDefinition> lenientUpstreamBlocks;
+
+    /**
+     * Packets re-decoded above carry this bridge's own BlockDefinition objects. The player's
+     * connection still checks them against Geyser's block registry, which does not know
+     * them, so any packet with a block in it (entity data of an enderman's held block, a
+     * falling block, a minecart's display block...) failed to encode and the player was
+     * kicked with "An internal error occurred". The runtime ids inside are already the
+     * ones the client's version expects, so accept any definition on that connection.
+     * Geyser can swap the registry later (on StartGame), so this re-wraps whenever it does.
+     */
+    public void allowTranslatedBlockDefinitions() {
+        final BedrockCodecHelper helper = session.getUpstream().getCodecHelper();
+        if (helper == null) {
+            return;
+        }
+        final DefinitionRegistry<BlockDefinition> current = helper.getBlockDefinitions();
+        if (current != null && current == this.lenientUpstreamBlocks) {
+            return;
+        }
+        this.lenientUpstreamBlocks = new DefinitionRegistry<>() {
+            @Override
+            public BlockDefinition getDefinition(int runtimeId) {
+                if (current != null) {
+                    final BlockDefinition definition = current.getDefinition(runtimeId);
+                    if (definition != null) {
+                        return definition;
+                    }
+                }
+                return () -> runtimeId;
+            }
+
+            @Override
+            public boolean isRegistered(BlockDefinition definition) {
+                return true;
+            }
+        };
+        helper.setBlockDefinitions(this.lenientUpstreamBlocks);
+    }
